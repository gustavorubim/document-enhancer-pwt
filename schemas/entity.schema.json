{
  "$defs": {
    "Authority": {
      "enum": [
        "explicit",
        "derived",
        "inferred",
        "reviewed"
      ],
      "title": "Authority",
      "type": "string"
    },
    "EntityType": {
      "enum": [
        "DocumentIdentity",
        "DocumentVersion",
        "Section",
        "Statement",
        "Table",
        "Figure",
        "Process",
        "ProcessStep",
        "Methodology",
        "MethodologyStep",
        "Activity",
        "Decision",
        "Trigger",
        "Requirement",
        "Control",
        "Risk",
        "Policy",
        "Standard",
        "Regulation",
        "Approval",
        "Evidence",
        "Record",
        "Role",
        "Organization",
        "EscalationPath",
        "System",
        "DataAsset",
        "DataElement",
        "Input",
        "Output",
        "Calculator",
        "Model",
        "Parameter",
        "Rule",
        "Metric",
        "Threshold",
        "Formula",
        "ServiceLevel",
        "Assumption",
        "Limitation",
        "Exception",
        "Dependency",
        "Precondition",
        "CompletionCondition",
        "GlossaryTerm"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "Layer": {
      "enum": [
        "authoritative",
        "governed",
        "extracted",
        "retrieval"
      ],
      "title": "Layer",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Mandatory traceability attached to every semantic node and relationship.",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "document_id": {
          "pattern": "^DOC-[A-Z0-9-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "document_version_id": {
          "anyOf": [
            {
              "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version Id"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "extraction_method": {
          "title": "Extraction Method",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/ProvenanceOrigin"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "section_id": {
          "anyOf": [
            {
              "pattern": "^(SEC|PROV-SEC)-[A-Z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "source_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Span Id"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValidity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "document_id",
        "origin",
        "authority",
        "layer",
        "extraction_method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceOrigin": {
      "enum": [
        "source",
        "answer",
        "steering",
        "reference",
        "model"
      ],
      "title": "ProvenanceOrigin",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "accepted",
        "rejected",
        "waived",
        "deprecated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "Loss-aware location across Markdown, DOCX, PDF, and table sources.",
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "table_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Index"
        },
        "xml_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    },
    "TemporalValidity": {
      "additionalProperties": false,
      "description": "Inclusive validity interval; open-ended endpoints are allowed.",
      "properties": {
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "title": "TemporalValidity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Common fields present on every graph node.",
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "attributes": {
      "additionalProperties": true,
      "title": "Attributes",
      "type": "object"
    },
    "authority": {
      "anyOf": [
        {
          "$ref": "#/$defs/Authority"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entity_type": {
      "$ref": "#/$defs/EntityType"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "layer": {
      "anyOf": [
        {
          "$ref": "#/$defs/Layer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "provisional": {
      "default": false,
      "title": "Provisional",
      "type": "boolean"
    },
    "review_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "validity": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalValidity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "entity_type",
    "name",
    "provenance"
  ],
  "title": "Entity",
  "type": "object"
}
