{
  "$defs": {
    "SourceBlock": {
      "additionalProperties": false,
      "description": "One immutable source block with a stable span identifier.",
      "properties": {
        "block_type": {
          "$ref": "#/$defs/SourceBlockType"
        },
        "heading_level": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Level"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "substantive": {
          "default": true,
          "title": "Substantive",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Digest"
        }
      },
      "required": [
        "ordinal",
        "block_type",
        "text",
        "source_digest"
      ],
      "title": "SourceBlock",
      "type": "object"
    },
    "SourceBlockType": {
      "enum": [
        "heading",
        "paragraph",
        "list",
        "table",
        "figure",
        "formula",
        "code",
        "page_break",
        "header",
        "footer",
        "unknown"
      ],
      "title": "SourceBlockType",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "Loss-aware location across Markdown, DOCX, PDF, and table sources.",
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "table_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Index"
        },
        "xml_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Ordered parser output; later structure recovery must not mutate it.",
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/SourceBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "extraction_warnings": {
      "items": {
        "type": "string"
      },
      "title": "Extraction Warnings",
      "type": "array"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "parser_name": {
      "title": "Parser Name",
      "type": "string"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_digest": {
      "title": "Source Digest",
      "type": "string"
    },
    "source_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Path"
    }
  },
  "required": [
    "document_id",
    "source_digest",
    "media_type",
    "size_bytes",
    "blocks",
    "parser_name",
    "parser_version"
  ],
  "title": "RawDocument",
  "type": "object"
}
