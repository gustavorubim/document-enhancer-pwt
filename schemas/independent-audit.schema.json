{
  "$defs": {
    "AuditEvidence": {
      "additionalProperties": false,
      "description": "One immutable input or output citation used by an audit result.",
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "artifact",
        "locator"
      ],
      "title": "AuditEvidence",
      "type": "object"
    },
    "ContentAuditFinding": {
      "additionalProperties": false,
      "properties": {
        "auto_revisable": {
          "default": false,
          "title": "Auto Revisable",
          "type": "boolean"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "output_evidence": {
          "items": {
            "$ref": "#/$defs/AuditEvidence"
          },
          "minItems": 1,
          "title": "Output Evidence",
          "type": "array"
        },
        "proposed_disposition": {
          "title": "Proposed Disposition",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/AuditEvidence"
          },
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "category",
        "severity",
        "summary",
        "source_evidence",
        "output_evidence",
        "proposed_disposition"
      ],
      "title": "ContentAuditFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_id": {
      "title": "Audit Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ContentAuditFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "isolated_context": {
      "const": true,
      "default": true,
      "title": "Isolated Context",
      "type": "boolean"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "status",
    "provider"
  ],
  "title": "IndependentAuditResult",
  "type": "object"
}
