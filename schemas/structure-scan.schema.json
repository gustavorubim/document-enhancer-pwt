{
  "$defs": {
    "BoundaryRegion": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "end_span_id": {
          "title": "End Span Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "start_span_id": {
          "title": "Start Span Id",
          "type": "string"
        }
      },
      "required": [
        "start_span_id",
        "end_span_id",
        "confidence"
      ],
      "title": "BoundaryRegion",
      "type": "object"
    },
    "StructureDecision": {
      "enum": [
        "accept_parser",
        "recover",
        "needs_review"
      ],
      "title": "StructureDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambiguities": {
      "items": {
        "type": "string"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "boundary_regions": {
      "items": {
        "$ref": "#/$defs/BoundaryRegion"
      },
      "title": "Boundary Regions",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/StructureDecision"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "evidence_span_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Span Ids",
      "type": "array"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "parser_outline_digest": {
      "title": "Parser Outline Digest",
      "type": "string"
    },
    "prompt_digest": {
      "title": "Prompt Digest",
      "type": "string"
    },
    "prompt_id": {
      "title": "Prompt Id",
      "type": "string"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "source_digest": {
      "title": "Source Digest",
      "type": "string"
    }
  },
  "required": [
    "scan_id",
    "document_id",
    "source_digest",
    "parser_outline_digest",
    "decision",
    "confidence",
    "model",
    "prompt_id",
    "prompt_digest"
  ],
  "title": "StructureScan",
  "type": "object"
}
