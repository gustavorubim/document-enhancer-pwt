        "schema_name": {
          "title": "Schema Name",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "token_usage": {
          "additionalProperties": {
            "type": "integer"
