{
  "$defs": {
    "AuditEvidence": {
      "additionalProperties": false,
      "description": "One immutable input or output citation used by an audit result.",
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "artifact",
        "locator"
      ],
      "title": "AuditEvidence",
      "type": "object"
    },
    "AuditFindingKind": {
      "enum": [
        "editorial",
        "answer_clarification",
        "structured_fact",
        "inferred_proposal",
        "unresolved",
        "omission"
      ],
      "title": "AuditFindingKind",
      "type": "string"
    },
    "AuditRoutingDecision": {
      "additionalProperties": false,
      "properties": {
        "audit_revision": {
          "minimum": 0,
          "title": "Audit Revision",
          "type": "integer"
        },
        "blocker_ids": {
          "items": {
            "type": "string"
          },
          "title": "Blocker Ids",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "remaining_audit_revisions": {
          "minimum": 0,
          "title": "Remaining Audit Revisions",
          "type": "integer"
        },
        "route": {
          "enum": [
            "export",
            "auto_revise",
            "human_review",
            "failed"
          ],
          "title": "Route",
          "type": "string"
        }
      },
      "required": [
        "route",
        "reason",
        "audit_revision",
        "remaining_audit_revisions"
      ],
      "title": "AuditRoutingDecision",
      "type": "object"
    },
    "AuditStatus": {
      "enum": [
        "pass",
        "fail",
        "waiting"
      ],
      "title": "AuditStatus",
      "type": "string"
    },
    "ContentAuditFinding": {
      "additionalProperties": false,
      "properties": {
        "auto_revisable": {
          "default": false,
          "title": "Auto Revisable",
          "type": "boolean"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "output_evidence": {
          "items": {
            "$ref": "#/$defs/AuditEvidence"
          },
          "minItems": 1,
          "title": "Output Evidence",
          "type": "array"
        },
        "proposed_disposition": {
          "title": "Proposed Disposition",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/AuditEvidence"
          },
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "category",
        "severity",
        "summary",
        "source_evidence",
        "output_evidence",
        "proposed_disposition"
      ],
      "title": "ContentAuditFinding",
      "type": "object"
    },
    "DeterministicCheck": {
      "additionalProperties": false,
      "properties": {
        "auto_revisable": {
          "default": false,
          "title": "Auto Revisable",
          "type": "boolean"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/AuditEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "waived_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waived By"
        }
      },
      "required": [
        "check_id",
        "name",
        "category",
        "passed"
      ],
      "title": "DeterministicCheck",
      "type": "object"
    },
    "IndependentAuditResult": {
      "additionalProperties": false,
      "properties": {
        "audit_id": {
          "title": "Audit Id",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ContentAuditFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "isolated_context": {
          "const": true,
          "default": true,
          "title": "Isolated Context",
          "type": "boolean"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "audit_id",
        "status",
        "provider"
      ],
      "title": "IndependentAuditResult",
      "type": "object"
    },
    "QuestionStatus": {
      "enum": [
        "open",
        "answered",
        "deferred",
        "not_applicable",
        "waived"
      ],
      "title": "QuestionStatus",
      "type": "string"
    },
    "SemanticChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "change_id": {
          "title": "Change Id",
          "type": "string"
        },
        "change_type": {
          "enum": [
            "added",
            "removed",
            "changed",
            "retyped"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AuditFindingKind"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "change_id",
        "object_id",
        "change_type",
        "kind"
      ],
      "title": "SemanticChange",
      "type": "object"
    },
    "SemanticDiff": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "items": {
            "$ref": "#/$defs/SemanticChange"
          },
          "title": "Added",
          "type": "array"
        },
        "changed": {
          "items": {
            "$ref": "#/$defs/SemanticChange"
          },
          "title": "Changed",
          "type": "array"
        },
        "removed": {
          "items": {
            "$ref": "#/$defs/SemanticChange"
          },
          "title": "Removed",
          "type": "array"
        },
        "retyped": {
          "items": {
            "$ref": "#/$defs/SemanticChange"
          },
          "title": "Retyped",
          "type": "array"
        }
      },
      "title": "SemanticDiff",
      "type": "object"
    },
    "SourceTargetMapping": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source_span_id": {
          "title": "Source Span Id",
          "type": "string"
        },
        "target_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Anchor"
        },
        "target_object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Object Ids",
          "type": "array"
        }
      },
      "required": [
        "source_span_id",
        "disposition"
      ],
      "title": "SourceTargetMapping",
      "type": "object"
    },
    "Waiver": {
      "additionalProperties": false,
      "properties": {
        "approver": {
          "title": "Approver",
          "type": "string"
        },
        "downstream_impact": {
          "title": "Downstream Impact",
          "type": "string"
        },
        "expires_or_review_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires Or Review Date"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus",
          "default": "waived"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "waiver_id": {
          "title": "Waiver Id",
          "type": "string"
        }
      },
      "required": [
        "waiver_id",
        "target_id",
        "reason",
        "approver",
        "downstream_impact"
      ],
      "title": "Waiver",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_id": {
      "title": "Audit Id",
      "type": "string"
    },
    "deterministic_checks": {
      "items": {
        "$ref": "#/$defs/DeterministicCheck"
      },
      "title": "Deterministic Checks",
      "type": "array"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "independent_audit": {
      "$ref": "#/$defs/IndependentAuditResult"
    },
    "revision_count": {
      "default": 0,
      "minimum": 0,
      "title": "Revision Count",
      "type": "integer"
    },
    "routing": {
      "$ref": "#/$defs/AuditRoutingDecision"
    },
    "semantic_diff": {
      "$ref": "#/$defs/SemanticDiff"
    },
    "source_to_target": {
      "items": {
        "$ref": "#/$defs/SourceTargetMapping"
      },
      "title": "Source To Target",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/AuditStatus"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "textual_diff": {
      "default": "",
      "title": "Textual Diff",
      "type": "string"
    },
    "unresolved_issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Issue Ids",
      "type": "array"
    },
    "version_id": {
      "anyOf": [
        {
          "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version Id"
    },
    "waivers": {
      "items": {
        "$ref": "#/$defs/Waiver"
      },
      "title": "Waivers",
      "type": "array"
    }
  },
  "required": [
    "audit_id",
    "document_id",
    "status",
    "independent_audit",
    "routing"
  ],
  "title": "Audit",
  "type": "object"
}
