{
  "$defs": {
    "Authority": {
      "enum": [
        "explicit",
        "derived",
        "inferred",
        "reviewed"
      ],
      "title": "Authority",
      "type": "string"
    },
    "Layer": {
      "enum": [
        "authoritative",
        "governed",
        "extracted",
        "retrieval"
      ],
      "title": "Layer",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Mandatory traceability attached to every semantic node and relationship.",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "document_id": {
          "pattern": "^DOC-[A-Z0-9-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "document_version_id": {
          "anyOf": [
            {
              "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version Id"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "extraction_method": {
          "title": "Extraction Method",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/ProvenanceOrigin"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "section_id": {
          "anyOf": [
            {
              "pattern": "^(SEC|PROV-SEC)-[A-Z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "source_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Span Id"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValidity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "document_id",
        "origin",
        "authority",
        "layer",
        "extraction_method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceOrigin": {
      "enum": [
        "source",
        "answer",
        "steering",
        "reference",
        "model"
      ],
      "title": "ProvenanceOrigin",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "accepted",
        "rejected",
        "waived",
        "deprecated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "Loss-aware location across Markdown, DOCX, PDF, and table sources.",
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "table_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Index"
        },
        "xml_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    },
    "TemporalValidity": {
      "additionalProperties": false,
      "description": "Inclusive validity interval; open-ended endpoints are allowed.",
      "properties": {
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "title": "TemporalValidity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/Authority"
    },
    "canonical_terms": {
      "items": {
        "type": "string"
      },
      "title": "Canonical Terms",
      "type": "array"
    },
    "checksum": {
      "title": "Checksum",
      "type": "string"
    },
    "chunk_id": {
      "title": "Chunk Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "markdown_anchor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Markdown Anchor"
    },
    "object_ids": {
      "items": {
        "type": "string"
      },
      "title": "Object Ids",
      "type": "array"
    },
    "ordinal": {
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "section_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section Id"
    },
    "section_path": {
      "items": {
        "type": "string"
      },
      "title": "Section Path",
      "type": "array"
    },
    "security_classification": {
      "title": "Security Classification",
      "type": "string"
    },
    "source_span_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Span Ids",
      "type": "array"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "version_id": {
      "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "chunk_id",
    "document_id",
    "version_id",
    "text",
    "authority",
    "review_status",
    "provenance",
    "security_classification",
    "checksum",
    "ordinal"
  ],
  "title": "ExportChunk",
  "type": "object"
}
