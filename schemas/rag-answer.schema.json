{
  "$defs": {
    "ClaimCitation": {
      "additionalProperties": false,
      "properties": {
        "citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Citation Ids",
          "type": "array"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        }
      },
      "required": [
        "claim",
        "citation_ids"
      ],
      "title": "ClaimCitation",
      "type": "object"
    },
    "RagAnswerStatus": {
      "enum": [
        "answered",
        "partial",
        "insufficient"
      ],
      "title": "RagAnswerStatus",
      "type": "string"
    },
    "RagCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^DOC-[A-Z0-9-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "markdown_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown Anchor"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "source_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Span Ids",
          "type": "array"
        },
        "version_id": {
          "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "chunk_id",
        "document_id",
        "version_id"
      ],
      "title": "RagCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "title": "Answer Id",
      "type": "string"
    },
    "answer_markdown": {
      "title": "Answer Markdown",
      "type": "string"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/RagCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "claim_citations": {
      "items": {
        "$ref": "#/$defs/ClaimCitation"
      },
      "title": "Claim Citations",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "model_route": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Route"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RagAnswerStatus"
    },
    "unsupported_claims": {
      "items": {
        "type": "string"
      },
      "title": "Unsupported Claims",
      "type": "array"
    }
  },
  "required": [
    "answer_id",
    "query_id",
    "status",
    "answer_markdown"
  ],
  "title": "RagAnswer",
  "type": "object"
}
