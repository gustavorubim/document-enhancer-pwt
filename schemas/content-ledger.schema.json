{
  "$defs": {
    "ContentLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/LedgerDisposition"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "ledger_entry_id": {
          "title": "Ledger Entry Id",
          "type": "string"
        },
        "omitted_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Omitted Reason"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "source_ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ordinal"
        },
        "source_span_id": {
          "title": "Source Span Id",
          "type": "string"
        },
        "source_text_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text Digest"
        },
        "target_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Anchor"
        },
        "target_object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Object Ids",
          "type": "array"
        }
      },
      "required": [
        "ledger_entry_id",
        "source_span_id",
        "disposition",
        "rationale"
      ],
      "title": "ContentLedgerEntry",
      "type": "object"
    },
    "LedgerDisposition": {
      "enum": [
        "retained",
        "clarified",
        "moved",
        "split",
        "merged",
        "structured",
        "superseded",
        "deprecated",
        "omitted"
      ],
      "title": "LedgerDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ContentLedgerEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "ledger_id": {
      "title": "Ledger Id",
      "type": "string"
    }
  },
  "required": [
    "ledger_id",
    "document_id",
    "entries",
    "complete"
  ],
  "title": "ContentLedger",
  "type": "object"
}
