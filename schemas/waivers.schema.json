{
  "$defs": {
    "QuestionStatus": {
      "enum": [
        "open",
        "answered",
        "deferred",
        "not_applicable",
        "waived"
      ],
      "title": "QuestionStatus",
      "type": "string"
    },
    "Waiver": {
      "additionalProperties": false,
      "properties": {
        "approver": {
          "title": "Approver",
          "type": "string"
        },
        "downstream_impact": {
          "title": "Downstream Impact",
          "type": "string"
        },
        "expires_or_review_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires Or Review Date"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus",
          "default": "waived"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "waiver_id": {
          "title": "Waiver Id",
          "type": "string"
        }
      },
      "required": [
        "waiver_id",
        "target_id",
        "reason",
        "approver",
        "downstream_impact"
      ],
      "title": "Waiver",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "waivers": {
      "items": {
        "$ref": "#/$defs/Waiver"
      },
      "title": "Waivers",
      "type": "array"
    }
  },
  "required": [
    "document_id"
  ],
  "title": "WaiversArtifact",
  "type": "object"
}
