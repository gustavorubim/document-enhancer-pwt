            }
          ],
          "default": null,
          "title": "Max Size"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "value_type": {
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value_type"
      ],
      "title": "PromptVariable",
      "type": "object"
