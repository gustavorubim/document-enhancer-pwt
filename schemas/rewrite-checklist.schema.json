{
  "$defs": {
    "ChecklistAction": {
      "enum": [
        "retain",
        "clarify",
        "move",
        "split",
        "merge",
        "structure",
        "add_from_answer",
        "deprecate",
        "omit"
      ],
      "title": "ChecklistAction",
      "type": "string"
    },
    "ChecklistItem": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criterion": {
          "title": "Acceptance Criterion",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ChecklistAction"
        },
        "answer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Id"
        },
        "audit_requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Requirement"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "checklist_item_id": {
          "title": "Checklist Item Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceQuote"
          },
          "title": "Evidence",
          "type": "array"
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reference_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Rule Id"
        },
        "source_finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Finding Id"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus",
          "default": "open"
        },
        "steering_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steering Id"
        },
        "target_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Object Id"
        },
        "target_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Section Id"
        },
        "verification_method": {
          "title": "Verification Method",
          "type": "string"
        },
        "waiver_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiver Id"
        }
      },
      "required": [
        "checklist_item_id",
        "action",
        "verification_method",
        "acceptance_criterion",
        "blocking"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "EvidenceQuote": {
      "additionalProperties": false,
      "properties": {
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "span_id": {
          "title": "Span Id",
          "type": "string"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        }
      },
      "required": [
        "span_id",
        "quote"
      ],
      "title": "EvidenceQuote",
      "type": "object"
    },
    "QuestionStatus": {
      "enum": [
        "open",
        "answered",
        "deferred",
        "not_applicable",
        "waived"
      ],
      "title": "QuestionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "checklist_id": {
      "title": "Checklist Id",
      "type": "string"
    },
    "digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ChecklistItem"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "checklist_id",
    "document_id"
  ],
  "title": "RewriteChecklist",
  "type": "object"
}
