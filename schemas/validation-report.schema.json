{
  "$defs": {
    "ValidationDiagnostic": {
      "additionalProperties": false,
      "description": "One actionable reviewer-input diagnostic.\n\nPaths use the persisted YAML shape (for example ``answers.answers[0].answer``),\nwhich makes the output useful both to a person editing the file and to a script.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "provenance": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "title": "ValidationDiagnostic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stable validation response for answers, steering, waivers, or a bundle.",
  "properties": {
    "artifact_type": {
      "title": "Artifact Type",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/ValidationDiagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    }
  },
  "required": [
    "artifact_type",
    "valid"
  ],
  "title": "ReviewerValidationReport",
  "type": "object"
}
