{
  "$defs": {
    "Authority": {
      "enum": [
        "explicit",
        "derived",
        "inferred",
        "reviewed"
      ],
      "title": "Authority",
      "type": "string"
    },
    "EntityType": {
      "enum": [
        "DocumentIdentity",
        "DocumentVersion",
        "Section",
        "Statement",
        "Table",
        "Figure",
        "Process",
        "ProcessStep",
        "Methodology",
        "MethodologyStep",
        "Activity",
        "Decision",
        "Trigger",
        "Requirement",
        "Control",
        "Risk",
        "Policy",
        "Standard",
        "Regulation",
        "Approval",
        "Evidence",
        "Record",
        "Role",
        "Organization",
        "EscalationPath",
        "System",
        "DataAsset",
        "DataElement",
        "Input",
        "Output",
        "Calculator",
        "Model",
        "Parameter",
        "Rule",
        "Metric",
        "Threshold",
        "Formula",
        "ServiceLevel",
        "Assumption",
        "Limitation",
        "Exception",
        "Dependency",
        "Precondition",
        "CompletionCondition",
        "GlossaryTerm"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "ExportBundleManifest": {
      "additionalProperties": false,
      "properties": {
        "artifact_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifact Digests",
          "type": "object"
        },
        "bundle_id": {
          "title": "Bundle Id",
          "type": "string"
        },
        "chunks_count": {
          "minimum": 0,
          "title": "Chunks Count",
          "type": "integer"
        },
        "document_id": {
          "pattern": "^DOC-[A-Z0-9-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "edges_count": {
          "minimum": 0,
          "title": "Edges Count",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generation_policy": {
          "title": "Generation Policy",
          "type": "string"
        },
        "nodes_count": {
          "minimum": 0,
          "title": "Nodes Count",
          "type": "integer"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "validation_passed": {
          "title": "Validation Passed",
          "type": "boolean"
        },
        "version_id": {
          "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "document_id",
        "version_id",
        "schema_version",
        "generation_policy",
        "chunks_count",
        "nodes_count",
        "edges_count",
        "validation_passed"
      ],
      "title": "ExportBundleManifest",
      "type": "object"
    },
    "ExportChunk": {
      "additionalProperties": false,
      "properties": {
        "canonical_terms": {
          "items": {
            "type": "string"
          },
          "title": "Canonical Terms",
          "type": "array"
        },
        "checksum": {
          "title": "Checksum",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^DOC-[A-Z0-9-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "markdown_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown Anchor"
        },
        "object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "security_classification": {
          "title": "Security Classification",
          "type": "string"
        },
        "source_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Span Ids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "version_id": {
          "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "version_id",
        "text",
        "security_classification",
        "checksum",
        "ordinal"
      ],
      "title": "ExportChunk",
      "type": "object"
    },
    "ExportEdge": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "predicate": {
          "$ref": "#/$defs/RelationshipType"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "predicate",
        "target_id",
        "layer",
        "authority",
        "review_status",
        "provenance"
      ],
      "title": "ExportEdge",
      "type": "object"
    },
    "ExportNode": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "canonical_name": {
          "title": "Canonical Name",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        }
      },
      "required": [
        "id",
        "entity_type",
        "canonical_name",
        "layer",
        "authority",
        "review_status",
        "provenance"
      ],
      "title": "ExportNode",
      "type": "object"
    },
    "Layer": {
      "enum": [
        "authoritative",
        "governed",
        "extracted",
        "retrieval"
      ],
      "title": "Layer",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Mandatory traceability attached to every semantic node and relationship.",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "document_id": {
          "pattern": "^DOC-[A-Z0-9-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "document_version_id": {
          "anyOf": [
            {
              "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version Id"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "extraction_method": {
          "title": "Extraction Method",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "$ref": "#/$defs/ProvenanceOrigin"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "section_id": {
          "anyOf": [
            {
              "pattern": "^(SEC|PROV-SEC)-[A-Z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "source_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Span Id"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalValidity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "document_id",
        "origin",
        "authority",
        "layer",
        "extraction_method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceOrigin": {
      "enum": [
        "source",
        "answer",
        "steering",
        "reference",
        "model"
      ],
      "title": "ProvenanceOrigin",
      "type": "string"
    },
    "RelationshipType": {
      "enum": [
        "HAS_VERSION",
        "CURRENT_VERSION",
        "SUPERSEDES",
        "HAS_SECTION",
        "CONTAINS_STATEMENT",
        "CONTAINS_TABLE",
        "CONTAINS_FIGURE",
        "DEFINES",
        "REFERENCES",
        "GOVERNED_BY",
        "IMPLEMENTS",
        "HAS_STEP",
        "PRECEDES",
        "NEXT_ON_TRUE",
        "NEXT_ON_FALSE",
        "TRIGGERED_BY",
        "PERFORMED_BY",
        "ACCOUNTABLE_TO",
        "APPROVED_BY",
        "ESCALATES_TO",
        "CONSUMES",
        "PRODUCES",
        "USES",
        "USES_SYSTEM",
        "USES_DATA",
        "USES_CALCULATOR",
        "DEPENDS_ON",
        "REQUIRES",
        "HAS_PRECONDITION",
        "HAS_COMPLETION_CONDITION",
        "EVALUATES",
        "USES_METRIC",
        "HAS_THRESHOLD",
        "TRIGGERS",
        "MITIGATES",
        "ADDRESSES_RISK",
        "EXECUTES_CONTROL",
        "PRODUCES_EVIDENCE",
        "VALIDATED_BY",
        "TESTED_BY",
        "MONITORED_BY",
        "HAS_ASSUMPTION",
        "HAS_LIMITATION",
        "HAS_EXCEPTION",
        "OVERRIDES",
        "HAS_PARAMETER",
        "USES_MODEL",
        "USES_FORMULA",
        "DEFINED_BY",
        "HAS_ALIAS",
        "RELATED_TO_DOCUMENT"
      ],
      "title": "RelationshipType",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "in_review",
        "accepted",
        "rejected",
        "waived",
        "deprecated"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "Loss-aware location across Markdown, DOCX, PDF, and table sources.",
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "table_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Index"
        },
        "xml_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        }
      },
      "title": "SourceLocation",
      "type": "object"
    },
    "TemporalValidity": {
      "additionalProperties": false,
      "description": "Inclusive validity interval; open-ended endpoints are allowed.",
      "properties": {
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "title": "TemporalValidity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chunks": {
      "items": {
        "$ref": "#/$defs/ExportChunk"
      },
      "title": "Chunks",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/ExportEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/ExportBundleManifest"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ExportNode"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": [
    "manifest"
  ],
  "title": "ExportBundle",
  "type": "object"
}
