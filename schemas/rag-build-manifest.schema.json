{
  "additionalProperties": false,
  "properties": {
    "database_schema_version": {
      "title": "Database Schema Version",
      "type": "string"
    },
    "document_id": {
      "pattern": "^DOC-[A-Z0-9-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "embedding_backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Backend"
    },
    "embedding_dimension": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Dimension"
    },
    "embedding_input_format_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Input Format Version"
    },
    "embedding_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Model"
    },
    "failed_count": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Count",
      "type": "integer"
    },
    "foreign_key_check_passed": {
      "title": "Foreign Key Check Passed",
      "type": "boolean"
    },
    "fts_available": {
      "title": "Fts Available",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "graph_layer_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Graph Layer Counts",
      "type": "object"
    },
    "input_digests": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Digests",
      "type": "object"
    },
    "integrity_check_passed": {
      "title": "Integrity Check Passed",
      "type": "boolean"
    },
    "migration_version": {
      "title": "Migration Version",
      "type": "string"
    },
    "output_digests": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Output Digests",
      "type": "object"
    },
    "promotion_status": {
      "enum": [
        "not_started",
        "failed",
        "promoted"
      ],
      "title": "Promotion Status",
      "type": "string"
    },
    "rag_build_id": {
      "title": "Rag Build Id",
      "type": "string"
    },
    "row_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Row Counts",
      "type": "object"
    },
    "skipped_count": {
      "default": 0,
      "minimum": 0,
      "title": "Skipped Count",
      "type": "integer"
    },
    "validation_passed": {
      "title": "Validation Passed",
      "type": "boolean"
    },
    "vector_count": {
      "default": 0,
      "minimum": 0,
      "title": "Vector Count",
      "type": "integer"
    },
    "version_id": {
      "pattern": "^(DOCV|VER)-[A-Z0-9-]+$",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "rag_build_id",
    "document_id",
    "version_id",
    "database_schema_version",
    "migration_version",
    "fts_available",
    "integrity_check_passed",
    "foreign_key_check_passed",
    "promotion_status",
    "validation_passed"
  ],
  "title": "RagBuildManifest",
  "type": "object"
}
