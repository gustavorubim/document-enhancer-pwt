{
  "$defs": {
    "EvidenceQuote": {
      "additionalProperties": false,
      "properties": {
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "span_id": {
          "title": "Span Id",
          "type": "string"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        }
      },
      "required": [
        "span_id",
        "quote"
      ],
      "title": "EvidenceQuote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Narrow model output for one governed section rewrite.\n\nThe workflow, not the model, owns section ordering, semantic identities, tables, diagrams,\nand promotion.  This contract limits a provider to prose plus evidence already present in the\napproved section input.",
  "properties": {
    "approved_answer_ids": {
      "items": {
        "type": "string"
      },
      "title": "Approved Answer Ids",
      "type": "array"
    },
    "body": {
      "title": "Body",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceQuote"
      },
      "title": "Evidence",
      "type": "array"
    },
    "open_issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Open Issue Ids",
      "type": "array"
    },
    "section_id": {
      "pattern": "^(SEC|PROV-SEC)-[A-Z0-9-]+$",
      "title": "Section Id",
      "type": "string"
    },
    "source_span_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Span Ids",
      "type": "array"
    }
  },
  "required": [
    "section_id",
    "body"
  ],
  "title": "SectionRewriteDraft",
  "type": "object"
}
