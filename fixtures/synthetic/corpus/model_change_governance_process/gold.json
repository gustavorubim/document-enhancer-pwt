          "span_id": "SPN-MCG-002",
          "substantive": true,
          "text": "## Change intake",
          "text_digest": "f03a3dd0beeebb35f95f65e2f8507d8ef4e34a779b6a78e832a000b3c8f16aae",
          "untrusted": false
        },
