          "source_digest": "4ba79ff365417fe2583a7708b55d2aa4600935a3c91bb80870feaf3484c6009c",
          "span_id": "SPN-MCG-008",
          "substantive": true,
          "text": "## Evidence and rollback",
          "text_digest": "9139e28f6bed37b4a380ef087a9ed6921b062ecae6e60782d74f4c0ad3a00bd7",
          "untrusted": false
        },
        {
