          "section_id": "SEC-MCG-APPROVAL",
          "source_digest": "4ba79ff365417fe2583a7708b55d2aa4600935a3c91bb80870feaf3484c6009c",
          "span_id": "SPN-MCG-006",
          "substantive": true,
          "text": "## Approval and implementation",
          "text_digest": "4dac957e90da860310893f51ab1a115cab98db9e156b99c6927b5086b36b7df2",
          "untrusted": false
        },
        {
          "block_type": "paragraph",
          "ordinal": 6,
          "section_id": "SEC-MCG-APPROVAL",
          "source_digest": "4ba79ff365417fe2583a7708b55d2aa4600935a3c91bb80870feaf3484c6009c",
          "span_id": "SPN-MCG-007",
          "substantive": true,
          "text": "The Model Risk Committee approves high-impact changes. The implementation team deploys the approved version after validation evidence is attached.",
