          "span_id": "SPN-MCG-010",
          "substantive": true,
          "text": "## Version lifecycle",
          "text_digest": "2816b86cb04f867e3f613c842efdff8454b7dd269465f94e16ae606cf0f11a9f",
          "untrusted": false
        },
        {
