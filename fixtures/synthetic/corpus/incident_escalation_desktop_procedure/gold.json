          "section_id": "SEC-INCIDENT-COMPLETION",
          "source_digest": "f20457577d4b565f2a8a6e2f66ceb9f1fbe63f12fa4557dd54a8a5408d449c41",
          "span_id": "SPN-INCIDENT-010",
          "substantive": true,
          "text": "## Evidence and completion",
          "text_digest": "a2200ece27aaf6b0e5a0c9ac7c302e3020785c15de1fb872e0ff46a0302368f7",
          "untrusted": false
        },
        {
          "block_type": "paragraph",
          "ordinal": 10,
          "section_id": "SEC-INCIDENT-COMPLETION",
